{
  "manifest_version": 3,
  "name": "Tamkeen for Netflix & Prime Video",
  "short_name": "Tamkeen",
  "version": "0.0.0",
  "description": "Learn a language with Netflix and Prime Video: Tamkeen shows their subtitles in the language you're learning as words you can click.",
  "homepage_url": "https://christiangilkey.github.io/tamkeen/extension/",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Tamkeen for Netflix & Prime Video: open Netflix on titles in the language you're learning",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "webRequest"],
  "host_permissions": ["https://www.netflix.com/*", "https://*.nflxvideo.net/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content/config.js", "js/netflix-common.js", "js/netflix-player.js", "content/netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["js/netflix-common.js", "js/netflix-browser.js", "js/netflix-pad.js", "content/netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://learntamkeen.com/*", "https://christiangilkey.github.io/tamkeen/app/*"],
      "js": ["content/webapp.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.primevideo.com/*", "https://primevideo.com/*",
        "https://www.amazon.com/gp/video/*", "https://www.amazon.ca/gp/video/*", "https://www.amazon.com.mx/gp/video/*", "https://www.amazon.com.br/gp/video/*", "https://www.amazon.co.uk/gp/video/*", "https://www.amazon.de/gp/video/*", "https://www.amazon.fr/gp/video/*", "https://www.amazon.it/gp/video/*", "https://www.amazon.es/gp/video/*", "https://www.amazon.nl/gp/video/*", "https://www.amazon.se/gp/video/*", "https://www.amazon.pl/gp/video/*", "https://www.amazon.ae/gp/video/*", "https://www.amazon.sa/gp/video/*", "https://www.amazon.eg/gp/video/*", "https://www.amazon.in/gp/video/*", "https://www.amazon.co.jp/gp/video/*", "https://www.amazon.com.au/gp/video/*", "https://www.amazon.sg/gp/video/*"],
      "js": ["js/prime-common.js", "content/prime.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.html"], "matches": ["https://www.netflix.com/*"] },
    {
      "resources": ["js/extbridge.js", "js/netflix-ttml.js", "js/netflix-common.js", "js/ytcaptions.js", "js/languages.js", "js/wordlists/th.js"],
      "matches": ["https://learntamkeen.com/*", "https://christiangilkey.github.io/*"]
    },
    { "resources": ["prime.html"], "matches": ["https://www.primevideo.com/*", "https://primevideo.com/*",
      "https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.com.mx/*", "https://www.amazon.com.br/*", "https://www.amazon.co.uk/*", "https://www.amazon.de/*", "https://www.amazon.fr/*", "https://www.amazon.it/*", "https://www.amazon.es/*", "https://www.amazon.nl/*", "https://www.amazon.se/*", "https://www.amazon.pl/*", "https://www.amazon.ae/*", "https://www.amazon.sa/*", "https://www.amazon.eg/*", "https://www.amazon.in/*", "https://www.amazon.co.jp/*", "https://www.amazon.com.au/*", "https://www.amazon.sg/*"] }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "tamkeen-netflix@christiangilkey.github.io", "strict_min_version": "128.0" }
  }
}
